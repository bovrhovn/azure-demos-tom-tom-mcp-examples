<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
        <UserSecretsId>tt-location-intelligence</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="TT.Web.LocationIntelligence.Tests" />
        <PackageReference Include="Azure.AI.Projects" Version="2.0.1" />
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="1.5.0" />
        <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.28.0" />
        <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.64.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.2.0" />
        <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    </ItemGroup>

    <Target Name="BuildClient" BeforeTargets="ComputeFilesToPublish" Condition="'$(SkipClientBuild)' != 'true'">
        <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" />
        <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
        <ItemGroup>
            <ResolvedFileToPublish Include="wwwroot\dist\**\*">
                <RelativePath>wwwroot\dist\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>
