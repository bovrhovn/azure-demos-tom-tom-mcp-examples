@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<main class="error-page">
    <span class="eyebrow">APPLICATION ERROR</span>
    <h1>Something went wrong while processing your request.</h1>

    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }

    <p><a class="primary-link" href="/">Return to workspace</a></p>
</main>